# ============================================================================
# caiKU - GIS Air Bersih Pulau Jawa (.env.example)
# Salin file ini menjadi .env: cp .env.example .env   (Windows: copy .env.example .env)
# File .env tidak ikut ke Git; jangan menaruh password asli di file ini.
# ============================================================================

# Database Connection (SQLite default, atau ganti MySQL / PostgreSQL)
DATABASE_URL="file:./dev.db"

# Server Port
PORT=3000

# Isi "production" saat aplikasi dipakai orang lain: server menolak jalan
# bila ADMIN_PASSWORD atau AUTH_SECRET masih kosong.
# NODE_ENV=production

# Akun Petugas GIS (modul Update Titik Air).
# Jika ADMIN_PASSWORD kosong, login default petugas / caiku123 dipakai (hanya untuk coba-coba lokal).
ADMIN_USERNAME=petugas
ADMIN_PASSWORD=
ADMIN_NAME="Operator Unit Teknis"

# Kunci penanda tangan token login (string acak panjang). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Jika kosong, kunci acak dibuat setiap server menyala sehingga petugas harus login ulang setelah restart.
AUTH_SECRET=

# Batas permintaan per IP per menit untuk endpoint publik yang berat
# (/api/cakupan/* dan /api/route). Default 60.
# PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Opsional: hanya untuk skrip npm run pamsimas (Google Places API New, butuh billing)
# GOOGLE_MAPS_API_KEY=

# Opsional untuk skrip data (npm run seed / osm / pamsimas)
# File xlsx sumber data (default: database/Titik Air Se Jawa.xlsx)
# SEED_XLSX=database/Titik Air Se Jawa.xlsx
# Folder cache respons Google Places (default: database/places_cache) dan Overpass OSM (default: database/osm_cache)
# PLACES_CACHE_DIR=database/places_cache
# OSM_CACHE_DIR=database/osm_cache

# Opsional: Asisten Cakupan AI (Google Gemini). Kunci gratis dari https://aistudio.google.com/apikey
# Kunci hanya dipakai server, tidak dikirim ke browser. Kosong = panel AI nonaktif,
# analisis cakupan (jumlah SR & kecamatan tercakup) tetap berjalan tanpa AI.
GEMINI_API_KEY=
# Model Gemini (opsional). Kosongkan agar server memilih model Flash terbaru yang tersedia untuk
# kunci Anda, dengan cadangan otomatis ke model Flash/Flash-Lite lain bila model sedang sibuk (503).
# Model besar (pro/eksperimental) bisa butuh beberapa menit per jawaban dan akan dilewati otomatis.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Batas pertanyaan AI per IP per menit (default 15)
# AI_RATE_LIMIT_PER_MINUTE=15
# Batas waktu (ms) satu pertanyaan & satu panggilan ke Gemini (default 90000 & 15000)
# AI_TIMEOUT_MS=90000
# AI_CALL_TIMEOUT_MS=15000
