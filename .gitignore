# ============================================================================
# .gitignore - caiKU GIS Pemetaan Air Bersih Pulau Jawa
# ============================================================================

# 1. Dependency Modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Environment Variables & Secrets
.env
.env.*
# .env.example sengaja tidak di-ignore: menjadi contoh konfigurasi di repo
!.env.example

# 3. Database & SQLite Binary Files
*.db
*.db-journal
dev.db
dev.db-journal
prisma/*.db
prisma/*.db-journal

# 4. Runtime, Debug Logs & Hasil Tes
logs/
*.log
coverage/
.nyc_output/

# 5. OS & Filesystem Cache
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# File kunci sementara Office (muncul saat xlsx dibuka di Excel)
~$*

# 6. IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 7. AI & Temporary Scratch Folders
.agents/
.gemini/
scratch/
# Pengaturan Claude Code pribadi (izin lokal); .claude/settings.json bersama boleh di-commit
.claude/settings.local.json

# 8. Dataset Mentah, Arsip & Folder Referensi
# Dari folder database/ hanya xlsx sumber data yang ikut ke repo (dibutuhkan `npm run seed`);
# backup xlsx (*.sebelum-*.xlsx), cache Places/OSM/batas, dan berkas lain tetap lokal.
# Catatan: public/data/batas/ (GeoJSON hasil `npm run batas`) SENGAJA ikut repo.
*.csv
database/*
!database/Titik Air Se Jawa.xlsx
arsip/
plan.md
PROJECT_PLAN.md
referensi_dashboard/
referensi_update_titik/

