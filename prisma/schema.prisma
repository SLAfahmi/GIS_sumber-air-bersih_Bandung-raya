datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// TABEL 1: Wilayah Administratif (kab/kota se-Pulau Jawa)
// ============================================================
model Wilayah {
  id         Int            @id @default(autoincrement())
  kode       String         @unique  // contoh: KOTA-BANDUNG, KABUPATEN-BANDUNG-BARAT
  nama       String         @unique  // Kota Bandung, Kabupaten Lebak, dll
  tipe       String         // KOTA atau KABUPATEN
  provinsi   String         // Banten, DKI Jakarta, Jawa Barat, Jawa Tengah, DI Yogyakarta, Jawa Timur
  latCenter  Float?         // Titik tengah koordinat wilayah
  lngCenter  Float?
  createdAt  DateTime       @default(now())

  fasilitas  FasilitasAir[]

  @@index([tipe])
  @@index([provinsi])
}

// ============================================================
// TABEL 2: Entitas Pengelola Fasilitas Air
// ============================================================
model Pengelola {
  id        Int            @id @default(autoincrement())
  nama      String         @unique
  tipe      String         // PERUMDA, PEMDA, PAMSIMAS, LAINNYA
  kontak    String?
  alamat    String?
  createdAt DateTime       @default(now())

  fasilitas FasilitasAir[]

  @@index([tipe])
}

// ============================================================
// TABEL 3: Fasilitas Air (Tabel Utama)
// ============================================================
model FasilitasAir {
  id                 Int               @id @default(autoincrement())
  no                 Int?
  nodeId             String            @unique
  nama               String?           // Nama lokasi/fasilitas (mis. "PDAM Tirta Raharja - Unit Cileunyi")
  kategori           String            @default("Perumda") // Perumda, Pemda, Pamsimas, Kolam Retensi
  wilayahId          Int
  kecamatan          String?
  desaKelurahan      String?
  alamat             String?
  wilayahLayanan     String?           // Wilayah yang dilayani (bisa berbeda dari lokasi kantor)
  pengelolaId        Int
  jenisFasilitas     String
  latitude           Float
  longitude          Float
  statusOperasional  String            @default("Beroperasi Normal")
  statusVerifikasi   String?           // Terverifikasi lapangan, Terverifikasi (Google Places), Perlu cek ulang, dll
  catatanData        String?
  sumberData         String?           // Google Maps (Places API), Input Petugas GIS, dll
  sumberUrl          String?           // Link Google Maps titik (sudah memuat Place ID)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Relasi ke tabel lain
  wilayah            Wilayah           @relation(fields: [wilayahId], references: [id])
  pengelola          Pengelola         @relation(fields: [pengelolaId], references: [id])
  logPembaruan       LogPembaruan[]

  @@index([wilayahId])
  @@index([pengelolaId])
  @@index([kategori])
  @@index([jenisFasilitas])
  @@index([statusOperasional])
}

// ============================================================
// TABEL 4: Log Pembaruan Data (Audit Trail)
// ============================================================
model LogPembaruan {
  id          Int          @id @default(autoincrement())
  fasilitasId Int
  fieldDiubah String       // Nama field yang diubah
  nilaiLama   String?      // Nilai sebelumnya
  nilaiBaru   String?      // Nilai setelah diubah
  diubahOleh  String       @default("Sistem")
  keterangan  String?
  createdAt   DateTime     @default(now())

  fasilitas   FasilitasAir @relation(fields: [fasilitasId], references: [id], onDelete: Cascade)

  @@index([fasilitasId])
  @@index([createdAt])
}
